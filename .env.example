# Get this free from https://neon.tech (or Supabase)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Generate a long random string (you can use: openssl rand -base64 32)
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-key"

# Your live site URL
NEXTAUTH_URL="http://localhost:3000"

# Gmail SMTP (send to any user without buying a domain)
# 1. Google Account → Security → 2-Step Verification ON
# 2. App passwords → generate for Mail
# 3. Paste the 16-character app password as SMTP_PASS
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="AdCash Rewards <yourgmail@gmail.com>"
